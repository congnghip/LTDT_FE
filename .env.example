# Cấu hình biến môi trường kết nối Backend API cho ứng dụng Flutter (flutter_dotenv)
# Copy file này thành .env:
# cp .env.example .env (hoặc copy .env.example .env trên Windows CMD)

# 1. Chạy trên máy ảo Android Emulator: dùng IP 10.0.2.2 để kết nối vào máy host
BASE_URL=http://10.0.2.2:5000/api/

# 2. Chạy trên trình duyệt Web hoặc Windows Desktop:
# BASE_URL=http://localhost:5000/api/

# 3. Chạy trên thiết bị Android thật (kết nối cùng Wi-Fi): thay bằng IP LAN máy tính
# BASE_URL=http://192.168.1.xxx:5000/api/

# 4. Chạy qua Cloudflare Tunnel (Miễn phí, có HTTPS, dùng được ở mọi nơi qua 4G/Wifi):
# BASE_URL=https://your-tunnel-name.trycloudflare.com/api/
